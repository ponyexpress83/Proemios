    "db:reset": "sh scripts/postgres.sh reset",
    "db:genera-rollback": "node scripts/genera-rollback.mjs",
    "test:integrazione": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres@localhost:5433/proemios_test?sslmode=disable} vitest run tests/integrazione",
