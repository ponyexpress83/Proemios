# ------------------------------------------------------------------
# Proemios — variabili d'ambiente
#
# Copia in .env.local per lo sviluppo. Su Vercel: Project Settings → Env.
# Nessun valore reale in questo file: sono tutti segnaposto.
#
# La validazione vive in lib/env.ts (Zod). Una variabile mancante che serve
# davvero fa fallire l'avvio con un messaggio che dice cosa manca, invece di
# produrre un errore oscuro a runtime.
# ------------------------------------------------------------------

# === Sito ==========================================================
# URL pubblico canonico. Dominio principale: proemios.it
# Non usare mai proemios.com (appartiene a terzi).
NEXT_PUBLIC_SITE_URL="https://proemios.it"

# === Database ======================================================
# PostgreSQL. In produzione: Neon (regione UE).
# Il driver è node-postgres, non quello HTTP serverless: servono le
# transazioni, che il driver HTTP non supporta.
#
# Locale (scripts/postgres.sh):
#   postgres://postgres@localhost:5433/proemios_dev?sslmode=disable
DATABASE_URL="postgresql://utente:password@host.neon.tech/proemios?sslmode=require"
# Dimensione massima del pool (facoltativo, default 10).
DATABASE_POOL_MAX="10"
# Database usato dai test di integrazione (npm run test:integrazione).
TEST_DATABASE_URL="postgres://postgres@localhost:5433/proemios_test?sslmode=disable"

# === Autenticazione (Auth.js) ======================================
# Chiave di firma delle sessioni. Generala con: openssl rand -base64 32
# OBBLIGATORIA in produzione.
AUTH_SECRET=""
# URL canonico usato per costruire i link di accesso.
AUTH_URL="https://proemios.it"
# Mittente dei link di accesso. Il dominio dev'essere verificato su Resend.
AUTH_EMAIL_FROM="Proemios <accessi@proemios.it>"
# Durata della sessione in giorni (default 30, massimo 90).
AUTH_SESSION_DAYS="30"
# Indirizzo del primo amministratore, creato una volta sola da `npm run db:seed`.
# È l'unico account che nasce senza invito.
SEED_ADMIN_EMAIL=""

# === Storage dei file ==============================================
# "s3" in produzione, "filesystem" in sviluppo. Senza indicazione: s3 se
# S3_BUCKET è impostata, altrimenti filesystem.
STORAGE_DRIVER=""

# Bucket S3-compatibile, in regione UE. Requisiti operativi (docs/SECURITY.md):
# accesso pubblico bloccato, cifratura a riposo, versioning attivo,
# credenziali con i soli permessi Get/Put/Head/Delete sul prefisso.
S3_BUCKET=""
S3_REGION="eu-central-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Endpoint personalizzato per i servizi compatibili (R2, Scaleway, MinIO).
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# Solo per il driver filesystem, in sviluppo.
STORAGE_ROOT=".storage"
STORAGE_SIGNING_SECRET=""

# === Coda dei lavori (Inngest) =====================================
# Le elaborazioni editoriali durano minuti: non possono stare dentro una
# richiesta HTTP. In sviluppo basta `npx inngest-cli dev`, senza chiavi.
INNGEST_EVENT_KEY=""
# Verifica la firma delle richieste in arrivo su /api/inngest.
# OBBLIGATORIA in produzione: senza, chiunque potrebbe far partire
# l'elaborazione di un manoscritto.
INNGEST_SIGNING_KEY=""

# === Provider AI ===================================================
# Nessun modello è cablato nel codice: sono configurazione server-side e
# passano dal router, che rifiuta i provider senza policy privacy approvata.
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL=""
ANTHROPIC_MODEL_PREMIUM=""
OPENAI_MODEL=""
OPENAI_API_KEY="sk-..."

# === Pagamenti (Stripe) ============================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# === Email (Resend) ================================================
RESEND_API_KEY="re_..."
EMAIL_FROM="Proemios <noreply@proemios.it>"
EMAIL_INTERNAL="preventivi@proemios.it"

# === Fatturazione ==================================================
# Fatture in Cloud emette il documento fiscale: Proemios ne conserva solo il
# riferimento. Senza credenziali la fattura resta "da emettere" e
# l'amministrazione la vede in elenco — il prodotto non finge di averla emessa.
# Il token è un OAuth access token con lo scope sui documenti emessi.
FATTURE_IN_CLOUD_TOKEN=""
# Identificativo dell'azienda su Fatture in Cloud (l'id nell'URL del gestionale).
FATTURE_IN_CLOUD_AZIENDA_ID=""

# === WhatsApp ======================================================
# Cloud API di Meta. Fuori dai template approvati non si manda niente: un
# messaggio libero a chi non ha scritto per primo viene rifiutato da Meta.
# Senza credenziali il provider è spento e nessuno prova a inviare.
WHATSAPP_TOKEN=""
WHATSAPP_NUMERO_ID=""
# Numero mostrato nei pulsanti "scrivici su WhatsApp" (link wa.me, nessun invio).
NEXT_PUBLIC_WHATSAPP_NUMERO=""

# === Calendario ====================================================
# Deve essere https: nome ed email del cliente viaggiano in query string.
NEXT_PUBLIC_CALENDAR_URL="https://cal.com/proemios/call"

# === Analytics e Ads ===============================================
# Google Tag Manager: da lì si gestiscono Google Ads, GA4 e Meta Pixel
# senza rilasciare codice.
NEXT_PUBLIC_GTM_ID=""
# Analytics senza cookie (opzionale: Plausible, Umami).
NEXT_PUBLIC_ANALYTICS_DOMAIN=""

# Google Ads — conversioni offline.
# Gli eventi che contano (lead qualificato, proposta inviata, incasso)
# succedono sul server, quando nessun browser è aperto: un pixel non li vede.
# Si registrano in database e si caricano qui come conversioni offline.
# Senza queste variabili restano registrate e non inviate, visibili nel funnel.
GOOGLE_ADS_TOKEN=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
# Mappa evento→azione di conversione, separata da virgole:
#   qualified_lead=customers/123/conversionActions/456,purchase=customers/123/conversionActions/789
# Sta in configurazione perché gli id cambiano quando si tocca l'account, e
# non deve servire un rilascio.
GOOGLE_ADS_AZIONI=""

# === Conservazione =================================================
# Giorni dopo i quali l'estratto usato per l'analisi del manoscritto
# viene cancellato.
MANUSCRIPT_RETENTION_DAYS="30"

# === Modalità demo =================================================
# "on" per forzarla, "off" per escluderla. Vuota: la demo si attiva da sola
# quando manca DATABASE_URL.
#
# In produzione dev'essere "off". Il back-office accetta la demo solo se
# richiesta esplicitamente con "on": dedurla da una variabile mancante
# aprirebbe il cruscotto a chiunque su un deploy mal configurato.
DEMO_MODE=""
