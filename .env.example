# ─────────────────────────────────────────────────────────────
# Kalamos Studio — variabili d'ambiente (Fase 1)
# Copia questo file in `.env.local` e compila i valori.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database — Neon Postgres (serverless driver)
# Stringa di connessione "pooled" da Neon (https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/kalamos?sslmode=require"

# Stripe (modalità payment — nessun abbonamento in Fase 1)
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# Secret del webhook: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Resend — email transazionali (https://resend.com)
RESEND_API_KEY="re_xxx"
# Mittente verificato su Resend
EMAIL_FROM="Kalamos Studio <no-reply@kalamos.studio>"
# Destinatario delle notifiche interne (nuovi lead, preventivi, ordini)
EMAIL_INTERNAL_NOTIFY="finance@kalamos.studio"

# Anthropic — analisi manoscritto
ANTHROPIC_API_KEY="sk-ant-xxx"

# Admin (Basic Auth sulla pagina /admin)
ADMIN_USER="admin"
ADMIN_PASSWORD="cambiami-in-produzione"

# Calendly (embed nella pagina /contatti)
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/kalamos-studio/consulenza"

# Analisi manoscritto — giorni di conservazione del file prima della cancellazione
MANUSCRIPT_RETENTION_DAYS="30"
