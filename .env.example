# Proemios: missing services return errors. No implicit demo or default accounts.
# Set secrets only in protected local/Vercel configuration; never commit real values.
NEXT_PUBLIC_SITE_URL=https://proemios.it
# Preview: exact approved preview origin, distinct from the SEO origin.
APP_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
DATABASE_URL=
# Controlled one-time owner bootstrap: verified email explicitly approved by Valerio.
PROEMIOS_OWNER_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_INTERNAL=
BLOB_READ_WRITE_TOKEN=
FILE_SCANNER_URL=
FILE_SCANNER_TOKEN=
CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Activate only after supplier/data policy, quota, costs and retention are approved.
ANALYSIS_ENABLED=0
ANALYSIS_POLICY_APPROVED=0
ANALYSIS_MAX_JOBS_PER_DAY=
ANALYSIS_PER_USER_DAILY_LIMIT=
MANUSCRIPT_RETENTION_DAYS=
# Release gate; set only after the production checklist is evidenced.
PROEMIOS_PRODUCTION_READY=0
# Optional integrations: configure only real approved destinations.
NEXT_PUBLIC_CALENDAR_URL=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Google Analytics 4: si carica solo dopo il consenso esplicito (banner) e senza dati personali.
# Prima di impostarlo aggiorna la pagina /cookie (vedi docs/INTEGRAZIONI.md).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Brevo (campagne e recuperi di marketing): contatti autorizzati e webhook di disiscrizione/rimbalzo.
# Le email operative restano su Resend. Il segreto del webhook va passato come header x-proemios-webhook-secret o parametro t.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_WEBHOOK_SECRET=
DEMO_MODE=off
# Metodi di pagamento nel Checkout Stripe. Vuoto: quelli attivati nella Dashboard
# (carte, Klarna, Scalapay, addebito SEPA, bonifico). Esempio esplicito:
# STRIPE_PAYMENT_METHODS=card,klarna,customer_balance
STRIPE_PAYMENT_METHODS=
# Fatturazione automatica su Fatture in Cloud a ogni incasso confermato.
FIC_ACCESS_TOKEN=
FIC_COMPANY_ID=
# "1" trasmette subito allo SdI; altrimenti la fattura resta da inviare in Fatture in Cloud.
FIC_SEND_TO_SDI=0
# Id aliquota IVA in Fatture in Cloud (0 = 22% nei conti standard) e, se usata, quella esente.
FIC_VAT_ID=0
FIC_VAT_ID_EXEMPT=
# Conto d'incasso (es. "Stripe") su cui registrare i pagamenti.
FIC_PAYMENT_ACCOUNT_ID=
