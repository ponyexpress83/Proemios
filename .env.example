# Proemios: missing services return errors. No implicit demo or default accounts.
# Set secrets only in protected local/Vercel configuration; never commit real values.
NEXT_PUBLIC_SITE_URL=https://proemios.it
# Preview: exact approved preview origin, distinct from the SEO origin.
APP_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
DATABASE_URL=
# Controlled one-time owner bootstrap: verified email explicitly approved by Valerio.
PROEMIOS_OWNER_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_INTERNAL=
BLOB_READ_WRITE_TOKEN=
FILE_SCANNER_URL=
FILE_SCANNER_TOKEN=
CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Activate only after supplier/data policy, quota, costs and retention are approved.
ANALYSIS_ENABLED=0
ANALYSIS_POLICY_APPROVED=0
ANALYSIS_MAX_JOBS_PER_DAY=
ANALYSIS_PER_USER_DAILY_LIMIT=
MANUSCRIPT_RETENTION_DAYS=
# Release gate; set only after the production checklist is evidenced.
PROEMIOS_PRODUCTION_READY=0
# Optional integrations: configure only real approved destinations.
NEXT_PUBLIC_CALENDAR_URL=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
DEMO_MODE=off
