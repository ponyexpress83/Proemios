# ------------------------------------------------------------------
# Proemios — variabili d'ambiente
# Copia in .env.local per lo sviluppo. Su Vercel: Project Settings > Env.
# ------------------------------------------------------------------

# URL pubblico del sito (canonico). Dominio principale: proemios.it
# Non usare mai proemios.com (appartiene a terzi).
NEXT_PUBLIC_SITE_URL="https://proemios.it"

# --- Database (Neon Postgres, driver serverless) ---
# Connection string con ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/proemios?sslmode=require"

# --- Anthropic (analisi manoscritto) ---
ANTHROPIC_API_KEY="sk-ant-..."
# Override del modello (facoltativo). Default: claude-sonnet-4-6
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Stripe (Fase 1: solo Checkout in modalità payment, acconti) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Resend (email transazionali) ---
RESEND_API_KEY="re_..."
# Mittente verificato su Resend
EMAIL_FROM="Proemios <noreply@proemios.it>"
# Destinatario delle notifiche interne (nuovi lead, preventivi, acconti)
EMAIL_INTERNAL="preventivi@proemios.it"

# --- Admin (Basic Auth via middleware, nessun account utente in Fase 1) ---
ADMIN_USER="admin"
ADMIN_PASSWORD="cambia-questa-password"

# --- Calendario per la pagina Contatti (embed) ---
NEXT_PUBLIC_CALENDAR_URL="https://cal.com/proemios/call"

# --- Analytics cookieless (opzionale, es. Plausible/Umami) ---
# Se impostato, nessun cookie banner necessario.
NEXT_PUBLIC_ANALYTICS_DOMAIN=""

# --- Retention analisi manoscritto (giorni prima della cancellazione) ---
MANUSCRIPT_RETENTION_DAYS="30"
